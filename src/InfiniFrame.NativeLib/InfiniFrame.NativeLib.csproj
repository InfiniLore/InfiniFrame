<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <PackageId>InfiniLore.InfiniFrame.NativeLib</PackageId>
        <OutputType>Library</OutputType>

        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>

        <NativeArch Condition="'$(Platform)'=='AnyCPU'">x64</NativeArch>
        <NativeArch Condition="'$(Platform)'!='AnyCPU'">$(Platform)</NativeArch>

        <NativeStamp>$(MSBuildThisFileDirectory)artifacts\native\.build.$(Configuration)-$(NativeArch).stamp</NativeStamp>
        <NativeOutputRoot>$(MSBuildThisFileDirectory)artifacts\native</NativeOutputRoot>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    </ItemGroup>

    <ItemGroup>
        <Compile Remove="Native\**\*" />
        <EmbeddedResource Remove="Native\**\*" />
        <Content Remove="Native\**\*" />
        <None Remove="Native\**\*" />

        <None Include="Native\**\*.*"
              Exclude="Native\build\**\*;Native\packages\**\*;Native\cmake-build-*\**\*;"
              Pack="false" />

        <Compile Remove="build\**\*" />
        <EmbeddedResource Remove="build\**\*" />
        <Content Remove="build\**\*" />
        <None Remove="build\**\*" />

        <NativeSource Include="Native\**\*.cpp" />
        <NativeSource Include="Native\**\*.h" />
        <NativeSource Include="Native\**\*.mm" />

    </ItemGroup>

    <!-- ========================================================= -->
    <!-- WINDOWS x64 -->
    <!-- ========================================================= -->
    <ItemGroup Condition="Exists('artifacts/native/windows/x64/$(Configuration)/InfiniFrame.Native.dll')">

        <None Include="artifacts/native/windows/x64/$(Configuration)/InfiniFrame.Native.dll"
              Pack="true"
              PackagePath="runtimes/win-x64/native/" />
    </ItemGroup>

    <ItemGroup Condition="Exists('artifacts/native/windows/x64/$(Configuration)/WebView2Loader.dll')">

        <None Include="artifacts/native/windows/x64/$(Configuration)/WebView2Loader.dll"
              Pack="true"
              PackagePath="runtimes/win-x64/native/" />
    </ItemGroup>

    <!-- ========================================================= -->
    <!-- WINDOWS arm64 -->
    <!-- ========================================================= -->
    <ItemGroup Condition="Exists('artifacts/native/windows/arm64/$(Configuration)/InfiniFrame.Native.dll')">

        <None Include="artifacts/native/windows/arm64/$(Configuration)/InfiniFrame.Native.dll"
              Pack="true"
              PackagePath="runtimes/win-arm64/native/" />
    </ItemGroup>

    <ItemGroup Condition="Exists('artifacts/native/windows/arm64/$(Configuration)/WebView2Loader.dll')">

        <None Include="artifacts/native/windows/arm64/$(Configuration)/WebView2Loader.dll"
              Pack="true"
              PackagePath="runtimes/win-arm64/native/" />
    </ItemGroup>

    <!-- ========================================================= -->
    <!-- LINUX x64 -->
    <!-- ========================================================= -->
    <ItemGroup Condition="Exists('artifacts/native/linux/x64/$(Configuration)/libInfiniFrame.Native.so')">

        <None Include="artifacts/native/linux/x64/$(Configuration)/libInfiniFrame.Native.so"
              Pack="true"
              PackagePath="runtimes/linux-x64/native/" />
    </ItemGroup>

    <!-- ========================================================= -->
    <!-- LINUX arm64 -->
    <!-- ========================================================= -->
    <ItemGroup Condition="Exists('artifacts/native/linux/arm64/$(Configuration)/libInfiniFrame.Native.so')">

        <None Include="artifacts/native/linux/arm64/$(Configuration)/libInfiniFrame.Native.so"
              Pack="true"
              PackagePath="runtimes/linux-arm64/native/" />
    </ItemGroup>

    <!-- ========================================================= -->
    <!-- macOS x64 -->
    <!-- ========================================================= -->
    <ItemGroup Condition="Exists('artifacts/native/osx/x64/$(Configuration)/libInfiniFrame.Native.dylib')">

        <None Include="artifacts/native/osx/x64/$(Configuration)/libInfiniFrame.Native.dylib"
              Pack="true"
              PackagePath="runtimes/osx-x64/native/" />
    </ItemGroup>

    <!-- ========================================================= -->
    <!-- macOS arm64 -->
    <!-- ========================================================= -->
    <ItemGroup Condition="Exists('artifacts/native/osx/arm64/$(Configuration)/libInfiniFrame.Native.dylib')">

        <None Include="artifacts/native/osx/arm64/$(Configuration)/libInfiniFrame.Native.dylib"
              Pack="true"
              PackagePath="runtimes/osx-arm64/native/" />
    </ItemGroup>

    <!-- ========================================================= -->
    <!-- BUILD NATIVE                                              -->
    <!-- ========================================================= -->

    <Target Name="BuildNative"
            BeforeTargets="CoreBuild"
            Inputs="@(NativeSource)"
            Outputs="$(NativeStamp)">

        <Exec Command="pwsh -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)native-build.ps1&quot; $(Configuration) $(NativeArch)" />

        <Touch Files="$(NativeStamp)" AlwaysCreate="true" />
    </Target>

    <Target Name="CleanNative" AfterTargets="Clean">
        <Exec Command="pwsh -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)native-clean.ps1&quot;" />
    </Target>

</Project>