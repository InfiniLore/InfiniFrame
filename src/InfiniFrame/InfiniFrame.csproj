<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <PackageId>InfiniLore.InfiniFrame</PackageId>
        <OutputType>Library</OutputType>
        <Description>Cross-platform .NET native window framework. Create desktop applications with web technologies (HTML/CSS/JS) using WebView2 on Windows, WebKitGTK on Linux, and WKWebView on macOS.</Description>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="../InfiniFrame.Application/InfiniFrame.Application.csproj" />
        <ProjectReference Include="../InfiniFrame.Window/InfiniFrame.Window.csproj" />
        <ProjectReference Include="../InfiniFrame.Interop/InfiniFrame.Interop.csproj" />
        <ProjectReference Include="../InfiniFrame.Security/InfiniFrame.Security.csproj" />
        <ProjectReference Include="../InfiniFrame.StaticAssets/InfiniFrame.StaticAssets.csproj" />
        <ProjectReference Include="../InfiniFrame.NativeBridge/InfiniFrame.NativeBridge.csproj" />
        <ProjectReference Include="../InfiniFrame.Shared/InfiniFrame.Shared.csproj" />
        <ProjectReference Include="../InfiniFrame.Js/InfiniFrame.Js.csproj" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="InfiniTests.InfiniFrame" />
    </ItemGroup>

</Project>
