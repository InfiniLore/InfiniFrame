<Project>

    <PropertyGroup>
        <NativeArch Condition="'$(NativeArch)'=='' and $([System.String]::Copy('$(RuntimeIdentifier)').EndsWith('-arm64'))">arm64</NativeArch>
        <NativeArch Condition="'$(NativeArch)'=='' and $([System.String]::Copy('$(RuntimeIdentifier)').EndsWith('-x64'))">x64</NativeArch>
        <NativeArch Condition="'$(NativeArch)'=='' and '$(PlatformTarget)'=='ARM64'">arm64</NativeArch>
        <NativeArch Condition="'$(NativeArch)'=='' and '$(PlatformTarget)'=='arm64'">arm64</NativeArch>
        <NativeArch Condition="'$(NativeArch)'=='' and '$(PlatformTarget)'=='X64'">x64</NativeArch>
        <NativeArch Condition="'$(NativeArch)'=='' and '$(PlatformTarget)'=='x64'">x64</NativeArch>
        <NativeArch Condition="'$(NativeArch)'=='' and '$(Platform)'=='X64'">x64</NativeArch>
        <NativeArch Condition="'$(NativeArch)'=='' and '$(Platform)'=='x64'">x64</NativeArch>
        <NativeArch Condition="'$(NativeArch)'=='' and '$(Platform)'=='ARM64'">arm64</NativeArch>
        <NativeArch Condition="'$(NativeArch)'=='' and '$(Platform)'=='arm64'">arm64</NativeArch>
        <NativeHostArchitecture>$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture)</NativeHostArchitecture>
        <NativeArch Condition="'$(NativeArch)'=='' and '$(Platform)'=='AnyCPU' and '$(NativeHostArchitecture)'=='Arm64'">arm64</NativeArch>
        <NativeArch Condition="'$(NativeArch)'=='' and '$(Platform)'=='AnyCPU' and '$(NativeHostArchitecture)'=='X64'">x64</NativeArch>
        <NativeArch Condition="'$(NativeArch)'=='' and '$(Platform)'=='AnyCPU'">x64</NativeArch>

        <NativePlatform Condition="$([MSBuild]::IsOSPlatform('Windows'))">windows</NativePlatform>
        <NativePlatform Condition="$([MSBuild]::IsOSPlatform('Linux'))">linux</NativePlatform>
        <NativePlatform Condition="$([MSBuild]::IsOSPlatform('OSX'))">osx</NativePlatform>

        <NativeOutputRoot>$(MSBuildThisFileDirectory)artifacts/native</NativeOutputRoot>
        <InfiniFrameSkipNativeBuild Condition="'$(InfiniFrameSkipNativeBuild)'==''">false</InfiniFrameSkipNativeBuild>
        <InfiniFrameEnableTestExports Condition="'$(InfiniFrameEnableTestExports)'=='' and '$(Configuration)'=='Debug'">true</InfiniFrameEnableTestExports>
        <InfiniFrameEnableTestExports Condition="'$(InfiniFrameEnableTestExports)'==''">false</InfiniFrameEnableTestExports>
        <NativeStamp>$(NativeOutputRoot)/$(NativePlatform)/$(NativeArch)/$(Configuration)/.build.$(InfiniFrameEnableTestExports).stamp</NativeStamp>
        <BeforePack>IncludeNativeArtifactsForPack;IncludeCurrentNativeArtifactsForCopyAndPack;$(BeforePack)</BeforePack>

        <WindowsX64>$(NativeOutputRoot)/windows/x64/$(Configuration)</WindowsX64>
        <WindowsArm64>$(NativeOutputRoot)/windows/arm64/$(Configuration)</WindowsArm64>
        <LinuxX64>$(NativeOutputRoot)/linux/x64/$(Configuration)</LinuxX64>
        <LinuxArm64>$(NativeOutputRoot)/linux/arm64/$(Configuration)</LinuxArm64>
        <MacOsX64>$(NativeOutputRoot)/osx/x64/$(Configuration)</MacOsX64>
        <MacOsArm64>$(NativeOutputRoot)/osx/arm64/$(Configuration)</MacOsArm64>

        <CurrentNativeRuntimeRid Condition="'$(NativePlatform)'=='windows' and '$(NativeArch)'=='x64'">win-x64</CurrentNativeRuntimeRid>
        <CurrentNativeRuntimeRid Condition="'$(NativePlatform)'=='windows' and '$(NativeArch)'=='arm64'">win-arm64</CurrentNativeRuntimeRid>
        <CurrentNativeRuntimeRid Condition="'$(NativePlatform)'=='linux' and '$(NativeArch)'=='x64'">linux-x64</CurrentNativeRuntimeRid>
        <CurrentNativeRuntimeRid Condition="'$(NativePlatform)'=='linux' and '$(NativeArch)'=='arm64'">linux-arm64</CurrentNativeRuntimeRid>
        <CurrentNativeRuntimeRid Condition="'$(NativePlatform)'=='osx' and '$(NativeArch)'=='x64'">osx-x64</CurrentNativeRuntimeRid>
        <CurrentNativeRuntimeRid Condition="'$(NativePlatform)'=='osx' and '$(NativeArch)'=='arm64'">osx-arm64</CurrentNativeRuntimeRid>

        <CurrentNativeLibraryName Condition="'$(NativePlatform)'=='windows'">InfiniFrame.Native.dll</CurrentNativeLibraryName>
        <CurrentNativeLibraryName Condition="'$(NativePlatform)'=='linux'">InfiniFrame.Native.so</CurrentNativeLibraryName>
        <CurrentNativeLibraryName Condition="'$(NativePlatform)'=='osx'">InfiniFrame.Native.dylib</CurrentNativeLibraryName>

        <CurrentNativeArtifact Condition="'$(CurrentNativeRuntimeRid)'!='' and '$(CurrentNativeLibraryName)'!=''">$(NativeOutputRoot)/$(NativePlatform)/$(NativeArch)/$(Configuration)/$(CurrentNativeLibraryName)</CurrentNativeArtifact>
    </PropertyGroup>

    <PropertyGroup Condition="'$(InfiniFrameEnableTestExports)' == 'true'">
        <DefineConstants>$(DefineConstants);InfiniFrameNativeTestExports</DefineConstants>
    </PropertyGroup>

    <ItemGroup>
        <Compile Remove="Native/**/*" />
        <EmbeddedResource Remove="Native/**/*" />
        <Content Remove="Native/**/*" />
        <None Remove="Native/**/*" />
        <None Include="Native/**/*.*"
              Exclude="Native/build/**/*;Native/packages/**/*;Native/cmake-build-*/**/*;"
              Pack="false" />

        <Compile Remove="build/**/*" />
        <EmbeddedResource Remove="build/**/*" />
        <Content Remove="build/**/*" />
        <None Remove="build/**/*" />

        <NativeSource Include="Native/**/*.cpp"
                      Exclude="Native/build/**/*;Native/packages/**/*;Native/cmake-build-*/**/*" />
        <NativeSource Include="Native/**/*.h"
                      Exclude="Native/build/**/*;Native/packages/**/*;Native/cmake-build-*/**/*" />
        <NativeSource Include="Native/**/*.mm"
                      Exclude="Native/build/**/*;Native/packages/**/*;Native/cmake-build-*/**/*" />
        <NativeBuildInput Include="@(NativeSource)" />
        <NativeBuildInput Include="Native/**/CMakeLists.txt"
                          Exclude="Native/build/**/*;Native/packages/**/*;Native/cmake-build-*/**/*" />
        <NativeBuildInput Include="Native/**/*.cmake"
                          Exclude="Native/build/**/*;Native/packages/**/*;Native/cmake-build-*/**/*" />
        <NativeBuildInput Include="native-build.ps1" />
    </ItemGroup>

    <ItemGroup>
        <_NativeArtifactForPack Include="$(WindowsX64)/InfiniFrame.Native.dll"
                                Condition="Exists('$(WindowsX64)/InfiniFrame.Native.dll')">
            <RuntimeRid>win-x64</RuntimeRid>
            <LinkName>InfiniFrame.Native.dll</LinkName>
        </_NativeArtifactForPack>
        <_NativeArtifactForPack Include="$(WindowsX64)/WebView2Loader.dll"
                                Condition="Exists('$(WindowsX64)/WebView2Loader.dll')">
            <RuntimeRid>win-x64</RuntimeRid>
            <LinkName>WebView2Loader.dll</LinkName>
        </_NativeArtifactForPack>
        <_NativeArtifactForPack Include="$(WindowsArm64)/InfiniFrame.Native.dll"
                                Condition="Exists('$(WindowsArm64)/InfiniFrame.Native.dll')">
            <RuntimeRid>win-arm64</RuntimeRid>
            <LinkName>InfiniFrame.Native.dll</LinkName>
        </_NativeArtifactForPack>
        <_NativeArtifactForPack Include="$(WindowsArm64)/WebView2Loader.dll"
                                Condition="Exists('$(WindowsArm64)/WebView2Loader.dll')">
            <RuntimeRid>win-arm64</RuntimeRid>
            <LinkName>WebView2Loader.dll</LinkName>
        </_NativeArtifactForPack>
        <_NativeArtifactForPack Include="$(LinuxX64)/InfiniFrame.Native.so"
                                Condition="Exists('$(LinuxX64)/InfiniFrame.Native.so')">
            <RuntimeRid>linux-x64</RuntimeRid>
            <LinkName>InfiniFrame.Native.so</LinkName>
        </_NativeArtifactForPack>
        <_NativeArtifactForPack Include="$(LinuxArm64)/InfiniFrame.Native.so"
                                Condition="Exists('$(LinuxArm64)/InfiniFrame.Native.so')">
            <RuntimeRid>linux-arm64</RuntimeRid>
            <LinkName>InfiniFrame.Native.so</LinkName>
        </_NativeArtifactForPack>
        <_NativeArtifactForPack Include="$(MacOsX64)/InfiniFrame.Native.dylib"
                                Condition="Exists('$(MacOsX64)/InfiniFrame.Native.dylib')">
            <RuntimeRid>osx-x64</RuntimeRid>
            <LinkName>InfiniFrame.Native.dylib</LinkName>
        </_NativeArtifactForPack>
        <_NativeArtifactForPack Include="$(MacOsArm64)/InfiniFrame.Native.dylib"
                                Condition="Exists('$(MacOsArm64)/InfiniFrame.Native.dylib')">
            <RuntimeRid>osx-arm64</RuntimeRid>
            <LinkName>InfiniFrame.Native.dylib</LinkName>
        </_NativeArtifactForPack>
    </ItemGroup>

    <Target Name="BuildNative"
            BeforeTargets="DispatchToInnerBuilds;PrepareForBuild"
            Condition="'$(InfiniFrameSkipNativeBuild)' != 'true' and ('$(IsCrossTargetingBuild)' == 'true' or '$(TargetFramework)' != '')"
            Inputs="@(NativeBuildInput)"
            Outputs="$(NativeStamp)">
        <Exec Command="pwsh -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)native-build.ps1&quot; $(Configuration) $(NativeArch) $(InfiniFrameEnableTestExports)" />
        <Touch Files="$(NativeStamp)" AlwaysCreate="true" />
    </Target>

    <Target Name="IncludeNativeArtifactsForPack"
            BeforeTargets="_GetPackageFiles"
            Condition="'@(_NativeArtifactForPack)'!=''">
        <ItemGroup>
            <_PackageFiles Include="@(_NativeArtifactForPack)">
                <PackagePath>runtimes/%(RuntimeRid)/native/%(LinkName)</PackagePath>
                <BuildAction>Content</BuildAction>
            </_PackageFiles>
        </ItemGroup>
    </Target>

    <Target Name="IncludeCurrentNativeArtifactsForCopyAndPack"
            DependsOnTargets="BuildNative"
            BeforeTargets="GetCopyToOutputDirectoryItems;PrepareForBuild;_GetPackageFiles"
            Condition="'$(CurrentNativeRuntimeRid)'!=''">
        <ItemGroup>
            <_CurrentNativeArtifact Include="$(CurrentNativeArtifact)"
                                    Condition="Exists('$(CurrentNativeArtifact)')">
                <RuntimeRid>$(CurrentNativeRuntimeRid)</RuntimeRid>
                <LinkName>$(CurrentNativeLibraryName)</LinkName>
            </_CurrentNativeArtifact>

            <_CurrentNativeArtifact Include="$(NativeOutputRoot)/$(NativePlatform)/$(NativeArch)/$(Configuration)/WebView2Loader.dll"
                                    Condition="'$(NativePlatform)'=='windows' and Exists('$(NativeOutputRoot)/$(NativePlatform)/$(NativeArch)/$(Configuration)/WebView2Loader.dll')">
                <RuntimeRid>$(CurrentNativeRuntimeRid)</RuntimeRid>
                <LinkName>WebView2Loader.dll</LinkName>
            </_CurrentNativeArtifact>

            <_CurrentNativeArtifactToPack Include="@(_CurrentNativeArtifact)" />
            <_CurrentNativeArtifactToPack Remove="@(_NativeArtifactForPack)" />
        </ItemGroup>

        <ItemGroup>
            <None Include="@(_CurrentNativeArtifact)">
                <Visible>false</Visible>
                <Link>%(_CurrentNativeArtifact.LinkName)</Link>
                <PackagePath>runtimes/%(_CurrentNativeArtifact.RuntimeRid)/native/%(_CurrentNativeArtifact.LinkName)</PackagePath>
                <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
                <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
                <Pack>false</Pack>
            </None>
            <_PackageFiles Include="@(_CurrentNativeArtifactToPack)">
                <PackagePath>runtimes/%(RuntimeRid)/native/%(LinkName)</PackagePath>
                <BuildAction>Content</BuildAction>
            </_PackageFiles>
        </ItemGroup>
    </Target>

    <Target Name="CleanNative" AfterTargets="Clean">
        <Exec Command="pwsh -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)native-clean.ps1&quot;" />
    </Target>

    <Target Name="CheckNativeDlls" AfterTargets="Build" Condition="'$(TargetFramework)' == '' or '$(TargetFrameworks)' == ''">
        <Message Text="=== x64 ===" Importance="High" />

        <Message Condition="Exists('$(WindowsX64)/InfiniFrame.Native.dll')"
                 Text="✅ Found InfiniFrame.Native.dll in $(WindowsX64)"
                 Importance="High" />
        <Message Condition="!Exists('$(WindowsX64)/InfiniFrame.Native.dll')"
                 Text="❌ InfiniFrame.Native.dll not found at $(WindowsX64)!"
                 Importance="High" />

        <Message Condition="Exists('$(WindowsX64)/WebView2Loader.dll')"
                 Text="✅ Found WebView2Loader.dll in $(WindowsX64)"
                 Importance="High" />
        <Message Condition="!Exists('$(WindowsX64)/WebView2Loader.dll')"
                 Text="❌ WebView2Loader.dll not found at $(WindowsX64)!"
                 Importance="High" />

        <Message Condition="Exists('$(LinuxX64)/InfiniFrame.Native.so')"
                 Text="✅ Found InfiniFrame.Native.so in $(LinuxX64)"
                 Importance="High" />
        <Message Condition="!Exists('$(LinuxX64)/InfiniFrame.Native.so')"
                 Text="❌ InfiniFrame.Native.so not found at $(LinuxX64)!"
                 Importance="High" />

        <Message Condition="Exists('$(MacOsX64)/InfiniFrame.Native.dylib')"
                 Text="✅ Found InfiniFrame.Native.dylib in $(MacOsX64)"
                 Importance="High" />
        <Message Condition="!Exists('$(MacOsX64)/InfiniFrame.Native.dylib')"
                 Text="❌ InfiniFrame.Native.dylib not found at $(MacOsX64)!"
                 Importance="High" />

        <Message Text="=== arm64 ===" Importance="High" />

        <Message Condition="Exists('$(WindowsArm64)/InfiniFrame.Native.dll')"
                 Text="✅ Found InfiniFrame.Native.dll in $(WindowsArm64)"
                 Importance="High" />
        <Message Condition="!Exists('$(WindowsArm64)/InfiniFrame.Native.dll')"
                 Text="❌ InfiniFrame.Native.dll not found at $(WindowsArm64)!"
                 Importance="High" />

        <Message Condition="Exists('$(WindowsArm64)/WebView2Loader.dll')"
                 Text="✅ Found WebView2Loader.dll in $(WindowsArm64)"
                 Importance="High" />
        <Message Condition="!Exists('$(WindowsArm64)/WebView2Loader.dll')"
                 Text="❌ WebView2Loader.dll not found at $(WindowsArm64)!"
                 Importance="High" />

        <Message Condition="Exists('$(LinuxArm64)/InfiniFrame.Native.so')"
                 Text="✅ Found InfiniFrame.Native.so in $(LinuxArm64)"
                 Importance="High" />
        <Message Condition="!Exists('$(LinuxArm64)/InfiniFrame.Native.so')"
                 Text="❌ InfiniFrame.Native.so not found at $(LinuxArm64)!"
                 Importance="High" />

        <Message Condition="Exists('$(MacOsArm64)/InfiniFrame.Native.dylib')"
                 Text="✅ Found InfiniFrame.Native.dylib in $(MacOsArm64)"
                 Importance="High" />
        <Message Condition="!Exists('$(MacOsArm64)/InfiniFrame.Native.dylib')"
                 Text="❌ InfiniFrame.Native.dylib not found at $(MacOsArm64)!"
                 Importance="High" />
    </Target>

</Project>
