<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <PackageId>InfiniLore.InfiniFrame.NativeBridge</PackageId>
        <EnableDynamicLoading>true</EnableDynamicLoading>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <Description>C++ native bridge layer for InfiniFrame. Provides the P/Invoke interop between .NET and the native window implementations (WebView2, WebKitGTK, WKWebView).</Description>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="FluentValidation"/>
        <PackageReference Include="Microsoft.Web.WebView2"
                          Condition="$([MSBuild]::IsOSPlatform('Windows'))"
                          PrivateAssets="all"
                          ExcludeAssets="all"/>
        <PackageReference Include="Microsoft.Windows.ImplementationLibrary"
                          Condition="$([MSBuild]::IsOSPlatform('Windows'))"
                          PrivateAssets="all"
                          ExcludeAssets="all"/>
    </ItemGroup>

    <!--
        Microsoft.Extensions.Logging.Abstractions only became part of the shared framework in .NET 11
        (Microsoft.AspNetCore.App from .NET 10, Microsoft.NETCore.App from .NET 11). The native bridge
        deliberately has no ASP.NET Core framework reference, so on .NET 10 the abstractions still have
        to come from NuGet. From .NET 11 the shared framework provides them and NuGet prunes the
        reference (NU1510), which is why the reference is conditional on the target framework.
    -->
    <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions"/>
    </ItemGroup>

    <Import Project="InfiniFrame.NativeBridge.Native.targets"/>

</Project>
