<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <PackageId>InfiniLore.InfiniFrame.NativeBridge</PackageId>
        <OutputType>Library</OutputType>
        <EnableDynamicLoading>true</EnableDynamicLoading>

        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>

        <NativeArch Condition="'$(Platform)'=='AnyCPU'">x64</NativeArch>
        <NativeArch Condition="'$(Platform)'=='X64'">x64</NativeArch>
        <NativeArch Condition="'$(Platform)'=='x64'">x64</NativeArch>
        <NativeArch Condition="'$(Platform)'=='ARM64'">arm64</NativeArch>
        <NativeArch Condition="'$(Platform)'=='arm64'">arm64</NativeArch>
        
        <NativePlatform Condition="$([MSBuild]::IsOSPlatform('Windows'))">windows</NativePlatform>
        <NativePlatform Condition="$([MSBuild]::IsOSPlatform('Linux'))">linux</NativePlatform>
        <NativePlatform Condition="$([MSBuild]::IsOSPlatform('OSX'))">osx</NativePlatform>

        <NativeStamp>
            $(MSBuildThisFileDirectory)artifacts\native\$(NativePlatform)\$(NativeArch)\$(Configuration)\.build.stamp
        </NativeStamp>
        <NativeOutputRoot>$(MSBuildThisFileDirectory)artifacts\native</NativeOutputRoot>
        <InfiniFrameSkipNativeBuild Condition="'$(InfiniFrameSkipNativeBuild)'==''">false</InfiniFrameSkipNativeBuild>
        <InfiniFrameEnableTestExports Condition="'$(InfiniFrameEnableTestExports)'=='' and '$(Configuration)'=='Debug'">true</InfiniFrameEnableTestExports>
        <InfiniFrameEnableTestExports Condition="'$(InfiniFrameEnableTestExports)'==''">false</InfiniFrameEnableTestExports>

        <WindowsX64>$(NativeOutputRoot)\windows\x64\$(Configuration)</WindowsX64>
        <WindowsArm64>$(NativeOutputRoot)\windows\arm64\$(Configuration)</WindowsArm64>
        <LinuxX64>$(NativeOutputRoot)\linux\x64\$(Configuration)</LinuxX64>
        <LinuxArm64>$(NativeOutputRoot)\linux\arm64\$(Configuration)</LinuxArm64>
        <MacOsX64>$(NativeOutputRoot)\osx\x64\$(Configuration)</MacOsX64>
        <MacOsArm64>$(NativeOutputRoot)\osx\arm64\$(Configuration)</MacOsArm64>
    </PropertyGroup>

    <PropertyGroup Condition="'$(InfiniFrameEnableTestExports)' == 'true'">
        <DefineConstants>$(DefineConstants);InfiniFrameNativeTestExports</DefineConstants>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    </ItemGroup>

    <ItemGroup>
        <Compile Remove="Native\**\*" />
        <EmbeddedResource Remove="Native\**\*" />
        <Content Remove="Native\**\*" />
        <None Remove="Native\**\*" />
        <None Include="Native\**\*.*"
              Exclude="Native\build\**\*;Native\packages\**\*;Native\cmake-build-*\**\*;"
              Pack="false" />

        <Compile Remove="build\**\*" />
        <EmbeddedResource Remove="build\**\*" />
        <Content Remove="build\**\*" />
        <None Remove="build\**\*" />

        <NativeSource Include="Native\**\*.cpp" />
        <NativeSource Include="Native\**\*.h" />
        <NativeSource Include="Native\**\*.mm" />
    </ItemGroup>

    <!-- WINDOWS x64 -->
    <ItemGroup Condition="Exists('$(WindowsX64)\InfiniFrame.Native.dll')">
        <Content Include="$(WindowsX64)\InfiniFrame.Native.dll">
            <Visible>false</Visible>
            <Link Condition="'$(NativeArch)'=='x64' and '$(NativePlatform)'=='windows'">InfiniFrame.Native.dll</Link>
            <PackagePath>runtimes/win-x64/native/</PackagePath>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <Pack>true</Pack>
        </Content>
    </ItemGroup>

    <ItemGroup Condition="Exists('$(WindowsX64)\WebView2Loader.dll')">
        <Content Include="$(WindowsX64)\WebView2Loader.dll"
        >
            <Visible>false</Visible>
            <Link Condition="'$(NativeArch)'=='x64' and '$(NativePlatform)'=='windows'">WebView2Loader.dll</Link>
            <PackagePath>runtimes/win-x64/native/</PackagePath>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <Pack>true</Pack>
        </Content>
    </ItemGroup>

    <!-- WINDOWS arm64 -->
    <ItemGroup Condition="Exists('$(WindowsArm64)\InfiniFrame.Native.dll')">
        <Content Include="$(WindowsArm64)\InfiniFrame.Native.dll">
            <Visible>false</Visible>
            <Link Condition="'$(NativeArch)'=='arm64' and '$(NativePlatform)'=='windows'">InfiniFrame.Native.dll</Link>
            <PackagePath>runtimes/win-arm64/native/</PackagePath>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <Pack>true</Pack>
        </Content>
    </ItemGroup>

    <ItemGroup Condition="Exists('$(WindowsArm64)\WebView2Loader.dll')">
        <Content Include="$(WindowsArm64)\WebView2Loader.dll">
            <Visible>false</Visible>
            <Link Condition="'$(NativeArch)'=='arm64' and '$(NativePlatform)'=='windows'">WebView2Loader.dll</Link>
            <PackagePath>runtimes/win-arm64/native/</PackagePath>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <Pack>true</Pack>
        </Content>
    </ItemGroup>

    <!-- LINUX x64 -->
    <ItemGroup Condition="Exists('$(LinuxX64)\InfiniFrame.Native.so')">
        <Content Include="$(LinuxX64)\InfiniFrame.Native.so">
            <Visible>false</Visible>
            <Link Condition="'$(NativeArch)'=='x64' and '$(NativePlatform)'=='linux'">InfiniFrame.Native.so</Link>
            <PackagePath>runtimes/linux-x64/native/</PackagePath>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <Pack>true</Pack>
        </Content>
    </ItemGroup>

    <!-- LINUX arm64 -->
    <ItemGroup Condition="Exists('$(LinuxArm64)\InfiniFrame.Native.so')">
        <Content Include="$(LinuxArm64)\InfiniFrame.Native.so">
            <Visible>false</Visible>
            <Link Condition="'$(NativeArch)'=='arm64' and '$(NativePlatform)'=='linux'">InfiniFrame.Native.so</Link>
            <PackagePath>runtimes/linux-arm64/native/</PackagePath>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <Pack>true</Pack>
        </Content>
    </ItemGroup>

    <!-- macOS x64 -->
    <ItemGroup Condition="Exists('$(MacOsX64)\InfiniFrame.Native.dylib')">
        <Content Include="$(MacOsX64)\InfiniFrame.Native.dylib">
            <Visible>false</Visible>
            <Link Condition="'$(NativeArch)'=='x64' and '$(NativePlatform)'=='osx'">InfiniFrame.Native.dylib</Link>
            <PackagePath>runtimes/osx-x64/native/</PackagePath>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <Pack>true</Pack>
        </Content>
    </ItemGroup>

    <!-- macOS arm64 -->
    <ItemGroup Condition="Exists('$(MacOsArm64)\InfiniFrame.Native.dylib')">
        <Content Include="$(MacOsArm64)\InfiniFrame.Native.dylib">
            <Visible>false</Visible>
            <Link Condition="'$(NativeArch)'=='arm64' and '$(NativePlatform)'=='osx'">InfiniFrame.Native.dylib</Link>
            <PackagePath>runtimes/osx-arm64/native/</PackagePath>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <Pack>true</Pack>
        </Content>
    </ItemGroup>

    <!-- ========================================================= -->
    <!-- BUILD NATIVE                                              -->
    <!-- ========================================================= -->

    <Target Name="BuildNative"
            BeforeTargets="DispatchToInnerBuilds;PrepareForBuild"
            Condition="'$(InfiniFrameSkipNativeBuild)' != 'true' and ('$(IsCrossTargetingBuild)' == 'true' or '$(TargetFramework)' != '')"
            Inputs="@(NativeSource)"
            Outputs="$(NativeStamp)">

        <Exec Command="pwsh -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)native-build.ps1&quot; $(Configuration) $(NativeArch) $(InfiniFrameEnableTestExports)" />

        <Touch Files="$(NativeStamp)" AlwaysCreate="true" />
    </Target>

    <Target Name="CleanNative" AfterTargets="Clean" Condition="'$(TargetFramework)' == '' or '$(TargetFrameworks)' == ''">
        <Exec Command="pwsh -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)native-clean.ps1&quot;" />
    </Target>

    <Target Name="CheckNativeDlls" AfterTargets="Build" Condition="'$(TargetFramework)' == '' or '$(TargetFrameworks)' == ''">
        <Message Text="=== x64 ===" Importance="High"/>

        <Message Condition="Exists('$(WindowsX64)/InfiniFrame.Native.dll')"
                 Text="✅ Found InfiniFrame.Native.dll in $(WindowsX64)"
                 Importance="High"/>
        <Message Condition="!Exists('$(WindowsX64)/InfiniFrame.Native.dll')"
                 Text="❌ InfiniFrame.Native.dll not found at $(WindowsX64)!"
                 Importance="High"/>

        <Message Condition="Exists('$(WindowsX64)/WebView2Loader.dll')"
                 Text="✅ Found WebView2Loader.dll in $(WindowsX64)"
                 Importance="High"/>
        <Message Condition="!Exists('$(WindowsX64)/WebView2Loader.dll')"
                 Text="❌ WebView2Loader.dll not found at $(WindowsX64)!"
                 Importance="High"/>

        <Message Condition="Exists('$(LinuxX64)/InfiniFrame.Native.so')"
                 Text="✅ Found InfiniFrame.Native.so in $(LinuxX64)"
                 Importance="High"/>
        <Message Condition="!Exists('$(LinuxX64)/InfiniFrame.Native.so')"
                 Text="❌ InfiniFrame.Native.so not found at $(LinuxX64)!"
                 Importance="High"/>

        <Message Condition="Exists('$(MacOsX64)/InfiniFrame.Native.dylib')"
                 Text="✅ Found InfiniFrame.Native.dylib in $(MacOsX64)"
                 Importance="High"/>
        <Message Condition="!Exists('$(MacOsX64)/InfiniFrame.Native.dylib')"
                 Text="❌ InfiniFrame.Native.dylib not found at $(MacOsX64)!"
                 Importance="High"/>

        <Message Text="=== arm64 ===" Importance="High"/>

        <Message Condition="Exists('$(WindowsArm64)/InfiniFrame.Native.dll')"
                 Text="✅ Found InfiniFrame.Native.dll in $(WindowsArm64)"
                 Importance="High"/>
        <Message Condition="!Exists('$(WindowsArm64)/InfiniFrame.Native.dll')"
                 Text="❌ InfiniFrame.Native.dll not found at $(WindowsArm64)!"
                 Importance="High"/>

        <Message Condition="Exists('$(WindowsArm64)/WebView2Loader.dll')"
                 Text="✅ Found WebView2Loader.dll in $(WindowsArm64)"
                 Importance="High"/>
        <Message Condition="!Exists('$(WindowsArm64)/WebView2Loader.dll')"
                 Text="❌ WebView2Loader.dll not found at $(WindowsArm64)!"
                 Importance="High"/>

        <Message Condition="Exists('$(LinuxArm64)/InfiniFrame.Native.so')"
                 Text="✅ Found InfiniFrame.Native.so in $(LinuxArm64)"
                 Importance="High"/>
        <Message Condition="!Exists('$(LinuxArm64)/InfiniFrame.Native.so')"
                 Text="❌ InfiniFrame.Native.so not found at $(LinuxArm64)!"
                 Importance="High"/>

        <Message Condition="Exists('$(MacOsArm64)/InfiniFrame.Native.dylib')"
                 Text="✅ Found InfiniFrame.Native.dylib in $(MacOsArm64)"
                 Importance="High"/>
        <Message Condition="!Exists('$(MacOsArm64)/InfiniFrame.Native.dylib')"
                 Text="❌ InfiniFrame.Native.dylib not found at $(MacOsArm64)!"
                 Importance="High"/>
    </Target>

</Project>
