<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <PackageId>InfiniLore.InfiniFrame.Js</PackageId>
        <OutputType>Library</OutputType>

        <IsPackable>true</IsPackable>
        <RepositoryRoot>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../..'))</RepositoryRoot>

        <RunFrontendBuild Condition="'$(RunFrontendBuild)'==''">true</RunFrontendBuild>

        <FrontendProdFile>$(MSBuildProjectDirectory)/wwwroot/InfiniFrame.js</FrontendProdFile>
        <FrontendDevFile>$(MSBuildProjectDirectory)/wwwroot/InfiniFrame.dev.js</FrontendDevFile>
        <FrontendStampFile>$(MSBuildProjectDirectory)/obj/frontend-build.stamp</FrontendStampFile>
    </PropertyGroup>

    <ItemGroup>
        <Content Update="TypeScript/**/*"
                 Pack="false"
                 CopyToOutputDirectory="Never"
                 CopyToPublishDirectory="Never" />

        <Content Update="package.json"
                 Pack="false"
                 CopyToOutputDirectory="Never"
                 CopyToPublishDirectory="Never" />

        <Content Update="package-lock.json"
                 Pack="false"
                 CopyToOutputDirectory="Never"
                 CopyToPublishDirectory="Never" />

        <Content Update="tsconfig.json"
                 Pack="false"
                 CopyToOutputDirectory="Never"
                 CopyToPublishDirectory="Never" />

        <Content Update="vite.config.dev.ts"
                 Pack="false"
                 CopyToOutputDirectory="Never"
                 CopyToPublishDirectory="Never" />

        <Content Update="vite.config.prod.ts"
                 Pack="false"
                 CopyToOutputDirectory="Never"
                 CopyToPublishDirectory="Never" />

        <Content Update="vitest.config.ts"
                 Pack="false"
                 CopyToOutputDirectory="Never"
                 CopyToPublishDirectory="Never" />
    </ItemGroup>

    <ItemGroup>
        <Folder Include="wwwroot/" />
    </ItemGroup>

    <Target Name="BuildFrontend"
            BeforeTargets="DispatchToInnerBuilds;ResolveProjectStaticWebAssets;ResolveStaticWebAssets"
            Condition="'$(DesignTimeBuild)'!='true'
                     and '$(RunFrontendBuild)'=='true'
                     and '$(SkipTypeScriptBuild)'!='true'">

        <Message Text="Running frontend build..." Importance="high" />

        <Exec Command="node &quot;$(RepositoryRoot)/scripts/BuildFrontend.mjs&quot; &quot;$(MSBuildProjectDirectory)&quot; &quot;$(FrontendStampFile)&quot; &quot;$(FrontendProdFile)&quot; &quot;$(FrontendDevFile)&quot;"
              WorkingDirectory="$(MSBuildProjectDirectory)" />

        <Error Condition="!Exists('$(FrontendProdFile)')"
               Text="Missing: $(FrontendProdFile)" />

        <Error Condition="!Exists('$(FrontendDevFile)')"
               Text="Missing: $(FrontendDevFile)" />

        <Message Text="Frontend build completed successfully." Importance="high" />

    </Target>

    <Target Name="CleanFrontendOutput"
            AfterTargets="Clean"
            Condition="'$(DesignTimeBuild)'!='true'">

        <ItemGroup>
            <_FrontendGeneratedFiles Include="$(FrontendProdFile)" />
            <_FrontendGeneratedFiles Include="$(FrontendDevFile)" />
            <_FrontendGeneratedFiles Include="$(FrontendDevFile).map" />
            <_FrontendGeneratedFiles Include="$(FrontendStampFile)" />
        </ItemGroup>

        <Delete Files="@(_FrontendGeneratedFiles)"
                TreatErrorsAsWarnings="true" />

    </Target>

</Project>
