<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <PackageId>InfiniLore.InfiniFrame.Js</PackageId>
        <OutputType>Library</OutputType>

        <IsPackable>true</IsPackable>

        <RunFrontendBuild Condition="'$(RunFrontendBuild)'==''">true</RunFrontendBuild>

        <FrontendOutputFile>$(MSBuildProjectDirectory)\wwwroot\InfiniFrame.js</FrontendOutputFile>
        <FrontendStampFile>$(MSBuildProjectDirectory)\obj\frontend-build.stamp</FrontendStampFile>
    </PropertyGroup>

    <ItemGroup>
        <Content Update="TypeScript/**/*"
                 Pack="false"
                 CopyToOutputDirectory="Never"
                 CopyToPublishDirectory="Never"
                 Visible="true" />

        <Content Update="package.json"
                 Pack="false"
                 CopyToOutputDirectory="Never"
                 CopyToPublishDirectory="Never"
                 Visible="true" />

        <Content Update="package-lock.json"
                 Pack="false"
                 CopyToOutputDirectory="Never"
                 CopyToPublishDirectory="Never"
                 Visible="true" />

        <Content Update="tsconfig.json"
                 Pack="false"
                 CopyToOutputDirectory="Never"
                 CopyToPublishDirectory="Never"
                 Visible="true" />

        <Content Update="vite.config.ts"
                 Pack="false"
                 CopyToOutputDirectory="Never"
                 CopyToPublishDirectory="Never"
                 Visible="true" />

        <Content Update="vitest.config.ts"
                 Pack="false"
                 CopyToOutputDirectory="Never"
                 CopyToPublishDirectory="Never"
                 Visible="true" />
    </ItemGroup>

    <ItemGroup>
        <Folder Include="wwwroot\" />
    </ItemGroup>

    <Target Name="BuildFrontend"
            BeforeTargets="PrepareForBuild"
            Condition="'$(DesignTimeBuild)'!='true'
              and '$(RunFrontendBuild)'=='true'
              and '$(SkipTypeScriptBuild)'!='true'">

        <Message Text="Running frontend build..." Importance="high" />

        <Exec
            Command='node "$(MSBuildProjectDirectory)\..\..\scripts\BuildFrontend.mjs" "$(MSBuildProjectDirectory)" "$(FrontendStampFile)" "$(FrontendOutputFile)"'
            WorkingDirectory="$(MSBuildProjectDirectory)" />

        <PropertyGroup>
            <RunFrontendBuild>false</RunFrontendBuild>
        </PropertyGroup>

    </Target>

    <Target Name="CleanFrontendOutput"
            AfterTargets="Clean"
            Condition="'$(DesignTimeBuild)'!='true'">

        <ItemGroup>
            <_FrontendGeneratedFiles Include="$(FrontendOutputFile)" />
            <_FrontendGeneratedFiles Include="$(MSBuildProjectDirectory)\wwwroot\InfiniFrame.dev.js" />
            <_FrontendGeneratedFiles Include="$(MSBuildProjectDirectory)\wwwroot\InfiniFrame.dev.js.map" />
            <_FrontendGeneratedFiles Include="$(FrontendStampFile)" />
        </ItemGroup>

        <Delete Files="@(_FrontendGeneratedFiles)"
                TreatErrorsAsWarnings="true" />
    </Target>

</Project>