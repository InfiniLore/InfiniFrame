<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <PackageId>InfiniLore.InfiniFrame.Js</PackageId>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="InfiniFrame"/>
        <InternalsVisibleTo Include="InfiniFrame.WebServer"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Components.Web"/>
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="wwwroot/InfiniFrame.js"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="$(MSBuildThisFileDirectory)../InfiniFrame.Shared/InfiniFrame.Shared.csproj"/>
    </ItemGroup>

    <Target Name="BuildTypeScript" BeforeTargets="BeforeBuild" Condition="'$(Configuration)' == 'Release' and '$(SkipTypeScriptBuild)' != 'true'">
        <Exec Command="npm ci" WorkingDirectory="$(MSBuildThisFileDirectory)../.." />
        <Exec Command="npm run production:build" WorkingDirectory="$(MSBuildThisFileDirectory)../.." />
    </Target>

    <Target Name="BuildTypeScriptForPack" BeforeTargets="Pack" Condition="'$(SkipTypeScriptBuild)' != 'true'">
        <Exec Command="npm ci" WorkingDirectory="$(MSBuildThisFileDirectory)../.." />
        <Exec Command="npm run production:build" WorkingDirectory="$(MSBuildThisFileDirectory)../.." />
    </Target>

</Project>
