<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <PackageId>InfiniLore.InfiniFrame.Js</PackageId>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="InfiniFrame"/>
        <InternalsVisibleTo Include="InfiniFrame.WebServer"/>
        <InternalsVisibleTo Include="InfiniFrameTests"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Components.Web"/>
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="wwwroot/InfiniFrame.js"/>
    </ItemGroup>

    <ItemGroup>
        <Content Update="package.json" Pack="false" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" Visible="true" />
        <Content Update="package-lock.json" Pack="false" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" Visible="true" />
        <Content Update="webpack.config.js" Pack="false" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" Visible="true" />
        <Content Update="tsconfig.json" Pack="false" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" Visible="true" />
        <Content Update="TypeScript\**\*" Pack="false" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" Visible="true" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="$(MSBuildThisFileDirectory)../InfiniFrame.Shared/InfiniFrame.Shared.csproj"/>
    </ItemGroup>

    <Target Name="BuildTypeScript" BeforeTargets="DispatchToInnerBuilds" Condition="'$(Configuration)' == 'Release' and '$(SkipTypeScriptBuild)' != 'true' and '$(IsCrossTargetingBuild)' == 'true'">
        <Exec Command="npm ci" WorkingDirectory="$(MSBuildThisFileDirectory)" />
        <Exec Command="npm run production:build" WorkingDirectory="$(MSBuildThisFileDirectory)" />
    </Target>

    <Target Name="BuildTypeScriptSingleTarget" BeforeTargets="BeforeBuild" Condition="'$(Configuration)' == 'Release' and '$(SkipTypeScriptBuild)' != 'true' and '$(IsCrossTargetingBuild)' != 'true' and '$(TargetFrameworks)' == ''">
        <Exec Command="npm ci" WorkingDirectory="$(MSBuildThisFileDirectory)" />
        <Exec Command="npm run production:build" WorkingDirectory="$(MSBuildThisFileDirectory)" />
    </Target>

    <Target Name="BuildTypeScriptForPack" BeforeTargets="Pack" Condition="'$(SkipTypeScriptBuild)' != 'true' and '$(IsCrossTargetingBuild)' == 'true'">
        <Exec Command="npm ci" WorkingDirectory="$(MSBuildThisFileDirectory)" />
        <Exec Command="npm run production:build" WorkingDirectory="$(MSBuildThisFileDirectory)" />
    </Target>

</Project>
