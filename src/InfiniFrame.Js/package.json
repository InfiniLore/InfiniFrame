{
    "name": "infinilore.infiniframe.js-build",
    "version": "0.1.0",
    "scripts": {
        "typecheck": "tsc --noEmit",
        "build": "npm run typecheck && vite build --config vite.config.prod.ts && vite build --config vite.config.dev.ts",
        "watch": "concurrently \"vite build --watch --config vite.config.prod.ts\" \"vite build --watch --config vite.config.dev.ts\"",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage"
    },
    "keywords": [],
    "author": "",
    "license": "GNUv3",
    "description": "",
    "devDependencies": {
        "@types/node": "^26.1.1",
        "@vitest/coverage-v8": "^4.1.10",
        "concurrently": "^10.0.3",
        "jsdom": "^29.1.1",
        "terser": "^5.49.0",
        "typescript": "^7.0.2",
        "vite": "^8.1.5",
        "vitest": "^4.1.10"
    }
}
