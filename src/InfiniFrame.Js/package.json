{
    "name": "infinilore.infiniframe.js-build",
    "version": "0.1.0",
    "description": "JavaScript/TypeScript interop library for InfiniFrame Blazor applications. Provides the client-side bridge between C# and the browser.",
    "author": "InfiniLore",
    "license": "Apache-2.0",
    "keywords": ["infiniframe", "blazor", "interop", "webview", "desktop"],
    "scripts": {
        "typecheck": "tsc --noEmit",
        "build": "npm run typecheck && vite build --config vite.config.prod.ts && vite build --config vite.config.dev.ts",
        "watch": "concurrently \"vite build --watch --config vite.config.prod.ts\" \"vite build --watch --config vite.config.dev.ts\"",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage"
    },
    "keywords": [],
    "author": "",
    "license": "GNUv3",
    "description": "",
    "devDependencies": {
        "@types/node": "^26.2.0",
        "@vitest/coverage-v8": "^4.1.11",
        "concurrently": "^10.0.5",
        "jsdom": "^30.0.1",
        "terser": "^5.50.0",
        "typescript": "^7.0.2",
        "vite": "^8.2.2",
        "vitest": "^4.1.11"
    }
}
