{
    "name": "infinilore.infiniframe.js-build",
    "version": "0.1.0",
    "scripts": {
        "build": "vite build --config vite.config.prod.ts && vite build --config vite.config.dev.ts",
        "watch": "concurrently \"vite build --watch --config vite.config.prod.ts\" \"vite build --watch --config vite.config.dev.ts\"",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage"
    },
    "keywords": [],
    "author": "",
    "license": "GNUv3",
    "description": "",
    "devDependencies": {
        "@types/node": "^26.0.0",
        "@vitest/coverage-v8": "^4.1.9",
        "concurrently": "^10.0.3",
        "jsdom": "^29.1.1",
        "terser": "^5.48.0",
        "typescript": "^6.0.3",
        "vite": "^8.0.16",
        "vitest": "^4.1.9"
    }
}
