@using System.Text.Json
@using InfiniFrame
@implements IDisposable
@inject IInfiniFrameWindow Window
@inject WindowTestStateResetCoordinator StateResetCoordinator

<MudStack Spacing="4">
    <MudText Typo="Typo.h4">Window data exchange</MudText>
    <MudText Typo="Typo.body1">
        Input probes send entered data to InfiniFrame. Output probes read InfiniFrame data into their fields.
    </MudText>

    <MudGrid Spacing="3">
        <MudItem xs="12" md="6">
            <InputDataProbe
                Title="@_title"
                TitleId="current-window-title"
                ButtonText="Apply title / reset"
                ButtonId="title-toggle-button"
                DataInputId="title-data-input"
                DataLabel="Window title"
                Data="@_titleInput"
                DataChanged="value => _titleInput = value"
                Submitted="ApplyOrResetTitleAsync"/>
        </MudItem>
        <MudItem xs="12" md="6">
            <OutputDataProbe
                Title="Fullscreen"
                ButtonText="Toggle fullscreen"
                ButtonId="fullscreen-toggle-button"
                DataInputId="fullscreen-data-result"
                DataLabel="Current fullscreen state"
                Data="@_fullscreenData"
                ReadRequested="ToggleFullscreenAsync"/>
        </MudItem>
    </MudGrid>

    <MudDivider/>
    <MudText Typo="Typo.h5">Window feature readers</MudText>
    <MudGrid Spacing="3">
        @foreach (FeatureProbe feature in Features) {
            <MudItem xs="12" md="6" lg="4">
                <OutputDataProbe
                    Title="@feature.Title"
                    ButtonText="@feature.ButtonText"
                    ButtonId="@($"probe-{feature.Key}-feature")"
                    DataInputId="@($"{feature.Key}-feature-result")"
                    DataLabel="Serialized window data"
                    Data="@Result(feature.Key)"
                    ReadRequested="@(() => ReadFeatureAsync(feature))"/>
            </MudItem>
        }
    </MudGrid>
</MudStack>

@code {
    private readonly Dictionary<string, string?> _results = [];
    private string _title = WindowTestState.Default.Title;
    private string? _titleInput = "New Title";
    private string? _fullscreenData;
    private TaskCompletionSource<bool>? _resetRendered;

    private IReadOnlyList<FeatureProbe> Features => [
        new("browser", "Browser", "Read browser", ReadData: () => Serialize(Window.Features.Browser, select: feature => new {
            contextMenu = feature.IsContextMenuEnabled,
            mediaAutoplay = feature.IsMediaAutoplayEnabled,
            userAgent = feature.UserAgent,
            webSecurity = feature.IsWebSecurityEnabled,
            smoothScrolling = feature.IsSmoothScrollingEnabled
        })),
        new("decorations", "Decorations", "Read decorations", ReadData: () => Serialize(Window.Features.Decorations, select: feature => new {
            chromeless = feature.IsChromeless,
            transparent = feature.IsTransparent,
            title = feature.Title,
            limitLinuxTitle = feature.LimitLinuxWindowTitleLength
        })),
        new("position", "Position", "Read position", ReadData: () => Serialize(Window.Features.Position, select: feature => new {
            location = new { x = feature.Location.X, y = feature.Location.Y },
            top = feature.Top,
            left = feature.Left
        })),
        new("size", "Size", "Read size", ReadData: () => Serialize(Window.Features.Size, select: feature => new {
            size = new { width = feature.Size.Width, height = feature.Size.Height },
            width = feature.Width,
            height = feature.Height,
            resizable = feature.IsResizable
        })),
        new("state", "State", "Read state", ReadData: () => Serialize(Window.Features.State, select: feature => new {
            fullScreen = feature.IsFullScreen,
            maximized = feature.IsMaximized,
            minimized = feature.IsMinimized,
            topMost = feature.IsTopMost,
            zoomFactor = feature.ZoomFactor,
            zoomEnabled = feature.IsZoomEnabled
        })),
        new("lifecycle-monitors", "Lifecycle and monitors", "Read lifecycle and monitors", ReadData: () => Task.FromResult<string?>(
            JsonSerializer.Serialize(new {
                closedOrClosing = Window.Features.Lifecycle.IsClosedOrClosing(),
                dpi = Window.Features.Monitors.GetMainMonitorScreenDpi()
            })
        ))
    ];

    protected override void OnInitialized()
        => StateResetCoordinator.Resetting += RestoreDefaultUiStateAsync;

    private string? Result(string feature)
        => _results.GetValueOrDefault(feature);

    private async Task ReadFeatureAsync(FeatureProbe feature)
        => _results[feature.Key] = await feature.ReadData();

    private Task ToggleFullscreenAsync() {
        bool isFullScreen = !Window.Features.State.IsFullScreen;
        Window.Features.State.SetFullScreen(isFullScreen);
        _fullscreenData = isFullScreen.ToString();
        return Task.CompletedTask;
    }

    private Task ApplyOrResetTitleAsync(string? title) {
        string targetTitle = string.Equals(Window.Features.Decorations.Title, title, StringComparison.Ordinal)
            ? WindowTestState.Default.Title
            : title ?? string.Empty;

        Window.Features.Decorations.SetTitle(targetTitle);
        _title = targetTitle;
        return Task.CompletedTask;
    }

    private async Task RestoreDefaultUiStateAsync() {
        var resetRendered = new TaskCompletionSource<bool>(TaskCreationOptions.RunContinuationsAsynchronously);
        await InvokeAsync(() => {
            _resetRendered = resetRendered;
            _title = WindowTestState.Default.Title;
            _titleInput = "New Title";
            _fullscreenData = null;
            _results.Clear();
            StateHasChanged();
        });
        await resetRendered.Task;
    }

    protected override void OnAfterRender(bool firstRender) {
        TaskCompletionSource<bool>? resetRendered = _resetRendered;
        _resetRendered = null;
        resetRendered?.SetResult(true);
    }

    private static Task<string?> Serialize<TFeature, TValue>(TFeature feature, Func<TFeature, TValue> select)
        => Task.FromResult<string?>(JsonSerializer.Serialize(select(feature)));

    public void Dispose()
        => StateResetCoordinator.Resetting -= RestoreDefaultUiStateAsync;

    private sealed record FeatureProbe(
        string Key,
        string Title,
        string ButtonText,
        Func<Task<string?>> ReadData
    );

}
