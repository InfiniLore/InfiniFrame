<?xml version='1.0' encoding='utf-8'?>
<Project>
    <PropertyGroup>
        <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
        <LangVersion>14</LangVersion>

        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

        <IsPackable>false</IsPackable>

        <TargetDir Condition="'$(TargetDir)' == ''">$(MSBuildProjectDirectory)\bin\$(Configuration)\$(TargetFramework)\</TargetDir>
        <ApplicationIcon>../../assets/favicon.ico</ApplicationIcon>
    </PropertyGroup>

    <ItemGroup Condition="'$(MSBuildProjectName)' != 'InfiniTests'">
        <Using Include="TUnit.Mocks" />
        <Using Include="TUnit.Mocks.Arguments" />
        <Using Include="TUnit.Mocks.Generated" />
        <Using Include="static TUnit.Mocks.Arguments.Arg" />
    </ItemGroup>

    <ItemGroup>
        <Content Include="$(MSBuildThisFileDirectory)../assets/favicon.ico">
            <Link>wwwroot/favicon.ico</Link>
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
    </ItemGroup>
</Project>
