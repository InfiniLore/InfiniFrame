<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <EnableNativeDllCopy>true</EnableNativeDllCopy>
        <RepositoryRoot>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\..'))\</RepositoryRoot>

        <!-- Run frontend build once -->
        <FrontendBuildOnceTargetFramework Condition="'$(FrontendBuildOnceTargetFramework)'=='' and '$(TargetFrameworks)'!=''">
            $([System.String]::Copy('$(TargetFrameworks)').Split(';')[0])
        </FrontendBuildOnceTargetFramework>
        <FrontendBuildOnceTargetFramework Condition="'$(FrontendBuildOnceTargetFramework)'==''">
            $(TargetFramework)
        </FrontendBuildOnceTargetFramework>

        <!-- Anchor output -->
        <FrontendOutputFile>$(ProjectDir)wwwroot\index.html</FrontendOutputFile>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="TUnit" />
        <PackageReference Include="TUnit.Playwright" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\InfiniFrameTests.Playwright\InfiniFrameTests.Playwright.csproj" />
        <ProjectReference Include="..\InfiniFrameTests.Shared\InfiniFrameTests.Shared.csproj" />
    </ItemGroup>

    <!-- Track ALL frontend sources -->
    <ItemGroup>
        <FrontendSources Include="$(ProjectDir)Sources\infiniframe-playwright-vue\**\*" />
    </ItemGroup>

    <!-- Incremental frontend build -->
    <Target Name="BuildFrontend"
            BeforeTargets="Build"
            Inputs="@(FrontendSources)"
            Outputs="$(FrontendOutputFile)"
            Condition="'$(DesignTimeBuild)'!='true' 
                     and '$(TargetFramework)'=='$(FrontendBuildOnceTargetFramework)'">

        <Message Text="Running Vue frontend build..." Importance="high" />

        <Exec Command="npm ci"
              WorkingDirectory="$(ProjectDir)Sources\infiniframe-playwright-vue"
              Condition="!Exists('$(ProjectDir)Sources\infiniframe-playwright-vue\node_modules')" />

        <Exec Command="npm run build"
              WorkingDirectory="$(ProjectDir)Sources\infiniframe-playwright-vue" />

    </Target>

    <!-- Copy InfiniFrame bridge script -->
    <Target Name="CopyInfiniFrameBridgeScript"
            BeforeTargets="AssignTargetPaths"
            Condition="'$(DesignTimeBuild)'!='true'">
        <Copy SourceFiles="$(RepositoryRoot)src\InfiniFrame.Js\wwwroot\InfiniFrame.js"
              DestinationFiles="$(ProjectDir)wwwroot\InfiniFrame.js"
              SkipUnchangedFiles="true" />
    </Target>

    <!-- Copy frontend output -->
    <Target Name="CopyFrontendToOutput"
            AfterTargets="Build"
            Condition="'$(DesignTimeBuild)'!='true'">
        <ItemGroup>
            <FrontendFiles Include="$(ProjectDir)wwwroot\**\*" />
        </ItemGroup>

        <Copy SourceFiles="@(FrontendFiles)"
              DestinationFiles="@(FrontendFiles->'$(TargetDir)wwwroot\%(RecursiveDir)%(Filename)%(Extension)')"
              SkipUnchangedFiles="true" />
    </Target>

</Project>