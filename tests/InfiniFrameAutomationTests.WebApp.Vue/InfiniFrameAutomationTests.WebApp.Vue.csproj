<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <EnableNativeDllCopy>true</EnableNativeDllCopy>
        <RepositoryRoot>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\..'))\</RepositoryRoot>

        <!-- Build frontend exactly once during multi-target builds -->
        <FrontendBuildOnceTargetFramework Condition="'$(FrontendBuildOnceTargetFramework)'=='' and '$(TargetFrameworks)'!=''">$([System.String]::Copy('$(TargetFrameworks)').Split(';')[0])</FrontendBuildOnceTargetFramework>
        <FrontendBuildOnceTargetFramework Condition="'$(FrontendBuildOnceTargetFramework)'==''">$(TargetFramework)</FrontendBuildOnceTargetFramework>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="TUnit"/>
        <PackageReference Include="TUnit.Playwright"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\InfiniFrameAutomationTests\InfiniFrameAutomationTests.csproj" />
        <ProjectReference Include="..\InfiniFrameTests.Shared\InfiniFrameTests.Shared.csproj" />
    </ItemGroup>

    <Target Name="BuildFrontendCrossTargeting"
            BeforeTargets="AssignTargetPaths;Build"
            Condition="'$(DesignTimeBuild)'!='true' and '$(IsCrossTargetingBuild)'=='true'">
        <Message Text="Installing npm packages" Importance="high"/>
        <Exec Command="npm install" WorkingDirectory="$(ProjectDir)Sources\infiniframe-playwright-vue"/>
        <Message Text="Building frontend with npm..." Importance="high"/>
        <Exec Command="npm run build" WorkingDirectory="$(ProjectDir)Sources\infiniframe-playwright-vue"/>
    </Target>

    <Target Name="BuildFrontendSingleTarget"
            BeforeTargets="AssignTargetPaths;Build"
            Condition="'$(DesignTimeBuild)'!='true' and '$(IsCrossTargetingBuild)'!='true' and '$(TargetFramework)'!=''">
        <Message Text="Installing npm packages" Importance="high"/>
        <Exec Command="npm install" WorkingDirectory="$(ProjectDir)Sources\infiniframe-playwright-vue"/>
        <Message Text="Building frontend with npm..." Importance="high"/>
        <Exec Command="npm run build" WorkingDirectory="$(ProjectDir)Sources\infiniframe-playwright-vue"/>
    </Target>

    <Target Name="CopyInfiniFrameBridgeScript"
            DependsOnTargets="BuildFrontendSingleTarget"
            BeforeTargets="AssignTargetPaths;CopyFrontendToOutput"
            Condition="'$(DesignTimeBuild)'!='true' and '$(IsCrossTargetingBuild)'!='true'">
        <Copy SourceFiles="$(RepositoryRoot)src\InfiniFrame.Js\wwwroot\InfiniFrame.js"
              DestinationFiles="$(ProjectDir)wwwroot\InfiniFrame.js"
              SkipUnchangedFiles="true" />
    </Target>

    <Target Name="CopyFrontendToOutput"
            AfterTargets="Build"
            Condition="'$(DesignTimeBuild)'!='true' and '$(IsCrossTargetingBuild)'!='true'">
        <ItemGroup>
            <FrontendFiles Include="$(ProjectDir)wwwroot\**\*" />
        </ItemGroup>

        <Copy SourceFiles="@(FrontendFiles)"
              DestinationFiles="@(FrontendFiles->'$(TargetDir)wwwroot\%(RecursiveDir)%(Filename)%(Extension)')"
              SkipUnchangedFiles="true" />
    </Target>

</Project>


