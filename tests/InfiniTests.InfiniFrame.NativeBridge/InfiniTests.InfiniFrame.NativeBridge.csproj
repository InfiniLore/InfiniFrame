<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <InfiniFrameEnableTestExports Condition="'$(InfiniFrameEnableTestExports)'=='' and '$(Configuration)'=='Debug'">true</InfiniFrameEnableTestExports>
        <InfiniFrameEnableTestExports Condition="'$(InfiniFrameEnableTestExports)'==''">false</InfiniFrameEnableTestExports>
        <DefineConstants Condition="'$(InfiniFrameEnableTestExports)'=='true'">$(DefineConstants);InfiniFrameNativeTestExports</DefineConstants>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="TUnit"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\InfiniFrame.NativeBridge\InfiniFrame.NativeBridge.csproj"/>
        <ProjectReference Include="..\InfiniTests\InfiniTests.csproj" />
    </ItemGroup>

</Project>
