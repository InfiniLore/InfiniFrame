@page "/"
@using InfiniFrame
@using JetBrains.Annotations
@inject IInfiniFrameWindow Window

@* ReSharper disable once AsyncVoidMethod *@
<button id="fullscreen-toggle-button" @onclick="ToggleFullscreen">
    @if (_isFullscreen) {
        <span>Exit Fullscreen</span>
    }
    else {
        <span>Enter Fullscreen</span>
    }
</button>

@* ReSharper disable once AsyncVoidMethod *@
<button id="title-toggle-button" @onclick="ToggleTitle">
    @if (_isToggledToNewTitle) {
        <span>Reset Title</span>
    }
    else {
        <span>Define New Title</span>
    }
</button>

@code {
    private const string NewTitle = "New Title";

    private bool _isFullscreen;
    private bool _isToggledToNewTitle;
    private string _oldTitle = string.Empty;

    // -----------------------------------------------------------------------------------------------------------------
    // Methods
    // -----------------------------------------------------------------------------------------------------------------
    protected override void OnAfterRender(bool firstRender) {
        if (!firstRender) return;

        _isFullscreen = Window.FullScreen;
        StateHasChanged();
    }

    [UsedImplicitly]
    private void ToggleFullscreen() {
        bool targetFullscreen = !Window.FullScreen;
        Window.SetFullScreen(targetFullscreen);
        _isFullscreen = targetFullscreen;
        StateHasChanged();
    }

    [UsedImplicitly]
    private void ToggleTitle() {
        if (!_isToggledToNewTitle) {
            _oldTitle = Window.Title; // <-- store current title
            Window.SetTitle(NewTitle);
            _isToggledToNewTitle = true;
            return;
        }

        Window.SetTitle(_oldTitle);
        _oldTitle = string.Empty;
        _isToggledToNewTitle = false;
        StateHasChanged();
    }
}
