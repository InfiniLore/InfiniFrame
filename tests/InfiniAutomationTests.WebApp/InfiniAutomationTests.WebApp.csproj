<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <!-- Shared test infrastructure; this project is not a runnable test application. -->
        <IsTestingPlatformApplication>false</IsTestingPlatformApplication>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Playwright"/>
        <FrameworkReference Include="Microsoft.AspNetCore.App"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../InfiniAutomationTests/InfiniAutomationTests.csproj"/>
        <ProjectReference Include="../InfiniTests/InfiniTests.csproj" />
    </ItemGroup>

    <!-- These files are linked into each concrete framework test assembly. -->
    <ItemGroup>
        <Compile Remove="Shared/**/*.cs"/>
        <None Include="Shared/**/*.cs"/>
    </ItemGroup>
</Project>
