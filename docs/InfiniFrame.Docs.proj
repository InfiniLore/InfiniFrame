<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <RestoreProjectStyle>None</RestoreProjectStyle>
    <NoBuild>true</NoBuild>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <None Include="**/*"
          Exclude="bin/**;obj/**;_site/**;.doxygen/**;api/**/*.yml;api/toc.yml;api/.manifest" />
  </ItemGroup>

  <Target Name="Build">
    <Message Text="Skipping docs build in InfiniFrame.Docs.proj." Importance="High" />
  </Target>

  <Target Name="Clean">
    <Message Text="Skipping docs clean in InfiniFrame.Docs.proj." Importance="High" />
  </Target>

  <Target Name="Rebuild" DependsOnTargets="Clean;Build">
    <Message Text="Skipping docs rebuild in InfiniFrame.Docs.proj." Importance="High" />
  </Target>

  <Target Name="Restore">
    <Message Text="Skipping docs restore in InfiniFrame.Docs.proj." Importance="High" />
  </Target>

  <Target Name="Pack">
    <Message Text="Skipping docs pack in InfiniFrame.Docs.proj." Importance="High" />
  </Target>

    <Target Name="InvokeTestingPlatform">
        <Message Text="Skipping docs pack in InfiniFrame.Docs.proj." Importance="High"/>
    </Target>

    <Target Name="VSTest">
        <Message Text="Skipping docs pack in InfiniFrame.Docs.proj." Importance="High"/>
    </Target>

    <Target Name="_MTPBuild">
        <Message Text="Skipping docs pack in InfiniFrame.Docs.proj." Importance="High"/>
    </Target>
</Project>
