<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <OutputType>Exe</OutputType>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <InfiniFramePackAfterBuild>true</InfiniFramePackAfterBuild>
        <InfiniFramePackRid>auto</InfiniFramePackRid>
        <InfiniFramePackSelfContained>true</InfiniFramePackSelfContained>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\InfiniFrame\InfiniFrame.csproj" />
    </ItemGroup>

    <Target Name="InfiniFramePackAfterBuild"
            AfterTargets="Build"
            Condition="'$(InfiniFramePackAfterBuild)'=='true' and '$(PublishSingleFile)'!='true' and '$(InfiniFramePackInvoked)'!='true'">
        <Exec Command="dotnet run --project &quot;$(MSBuildProjectDirectory)\..\..\src\InfiniFrame.Tools.Pack\InfiniFrame.Tools.Pack.csproj&quot; --framework net10.0 -- publish &quot;$(MSBuildProjectFullPath)&quot; --rid $(InfiniFramePackRid) --configuration $(Configuration) --framework $(TargetFramework) --self-contained $(InfiniFramePackSelfContained)" />
    </Target>
</Project>
