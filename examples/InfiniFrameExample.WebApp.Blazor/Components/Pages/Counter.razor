@page "/counter"
@using InfiniFrame
@inject IInfiniFrameWindow Window
@inject ILogger<Counter> Logger
@rendermode InteractiveServer

<h1>Counter</h1>

<p>Current count: @_currentCount</p>

<button class="btn btn-primary" @onclick="@(_ => IncrementCount())">Click me</button>

@code {
    private int _currentCount;

    private void IncrementCount() {
        _currentCount++;

        Window.CenterOnCurrentMonitor();

        Logger.LogWarning("zoom : {a}", Window.Zoom);
        Window.SetZoom(Window.Zoom + 5);
        Logger.LogWarning("zoom new : {a}", Window.Zoom);
    }
}