<Project Sdk="Microsoft.NET.Sdk.Web">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <OutputType>Exe</OutputType>
        <LangVersion>14.0</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <ApplicationIcon>../../../assets/favicon.ico</ApplicationIcon>
        <PublishIISAssets>false</PublishIISAssets>
        <InfiniFrameSingleFileAuto>true</InfiniFrameSingleFileAuto>
        <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="../../../src/InfiniFrame.Blazor/InfiniFrame.Blazor.csproj" />
        <ProjectReference Include="../../../src/InfiniFrame.WebServer/InfiniFrame.WebServer.csproj" />
        <ProjectReference Include="../../../src/InfiniFrame.BlazorWebView/InfiniFrame.BlazorWebView.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="MudBlazor" />
        <PackageReference Include="Serilog"/>
        <PackageReference Include="Serilog.AspNetCore"/>
        <PackageReference Include="Serilog.Sinks.Async"/>
        <PackageReference Include="Serilog.Sinks.Console"/>
    </ItemGroup>

    <ItemGroup>
        <Content Include="../../../assets/favicon.ico">
            <Link>wwwroot/favicon.ico</Link>
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

    <ItemGroup>
        <None Include="bin/$(Configuration)/$(TargetFramework)/**/publish/$(AssemblyName).exe;
                       bin/$(Configuration)/$(TargetFramework)/**/publish/$(AssemblyName)"
              Visible="true">
            <Link>builds/$(Configuration)/$(TargetFramework)/%(RecursiveDir)%(Filename)%(Extension)</Link>
        </None>
        <None Include="wwwroot\index.html" />
    </ItemGroup>

    <Import Project="../../../InfiniFrame.NativeCopy.targets" />
    <Import Project="../../../src/InfiniFrame.SingleFile/InfiniFrame.SingleFile.targets"
            Condition="Exists('../../../src/InfiniFrame.SingleFile/InfiniFrame.SingleFile.targets')" />
</Project>
