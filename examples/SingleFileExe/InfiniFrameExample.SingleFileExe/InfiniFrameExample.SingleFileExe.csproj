<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <OutputType>Exe</OutputType>
        <LangVersion>14.0</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <ApplicationIcon>../../../assets/favicon.ico</ApplicationIcon>
        <PublishIISAssets>false</PublishIISAssets>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="../../../src/InfiniFrame/InfiniFrame.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Content Include="../../../assets/favicon.ico">
            <Link>wwwroot/favicon.ico</Link>
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

    <ItemGroup>
        <None Include="bin/Release/$(TargetFramework)/**/publish/$(AssemblyName).exe;
                       bin/Release/$(TargetFramework)/**/publish/$(AssemblyName)"
              Visible="true">
            <Link>builds/$(Configuration)/$(TargetFramework)/%(RecursiveDir)%(Filename)%(Extension)</Link>
        </None>
    </ItemGroup>

    <Import Project="../../../InfiniFrame.NativeCopy.targets" />
    <Import Project="../../../src/InfiniFrame.SingleFile/InfiniFrame.SingleFile.targets"
            Condition="Exists('../../../src/InfiniFrame.SingleFile/InfiniFrame.SingleFile.targets')" />

    <PropertyGroup>
        <InfiniFrameSingleFileAuto>true</InfiniFrameSingleFileAuto>
        <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    </PropertyGroup>
</Project>
