@page "/"
@using InfiniFrame
@inject IInfiniFrameWindow Window
@rendermode InteractiveServer

<h1>Hello, world!</h1>

Welcome to your new app.

<button @onclick="OnClickHandle">FOCUS</button>

@code {

    public async Task OnClickHandle() {
        await Task.Delay(5000);

        Window.SetFocused();
    }
}
