@using InfiniFrame.Blazor
@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu/>
    </div>

    <div class="main">
        <div class="top-row align-items-start">
            <InfiniFrameWindowDragArea class="w-100 h-100" style="background-color: rgba(0,0,0,0.25)"/>

            <InfiniFrameWindowButton WindowAction="WindowAction.Minimize"/>
            <InfiniFrameWindowButton WindowAction="WindowAction.Maximize"/>
            <InfiniFrameWindowButton WindowAction="WindowAction.Close"/>
        </div>

        <div class="content px-4 ">
            @Body
        </div>
    </div>
</div>

<InfiniFrameWindowResizeThumbContainer/>