<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
        <OutputType>Exe</OutputType>
        <LangVersion Condition="'$(TargetFramework)' == 'net10.0'">14.0</LangVersion>
        <LangVersion Condition="'$(TargetFramework)' == 'net11.0'">15.0</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <ApplicationIcon>../../assets/favicon.ico</ApplicationIcon>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="../../src/InfiniFrame/InfiniFrame.csproj" />
    </ItemGroup>

    <Import Project="../../InfiniFrame.NativeCopy.targets" />
</Project>
